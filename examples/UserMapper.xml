    <!-- Query with NVL and DECODE -->
    <select id="getUserReport" resultType="UserReport">
        SELECT
        user_id,
        username,
        NVL(email, 'no-email@example.com') as email,
        DECODE(status, 'A', 'Active', 'I', 'Inactive', 'Unknown') as status_text,
        created_date
        FROM users
        WHERE department_id = #{departmentId}
    </select>

    <!-- Hierarchical query with CONNECT BY -->
    <select id="getUserHierarchy" resultType="UserNode">
        SELECT
        user_id,
        username,
        manager_id,
        LEVEL as hierarchy_level,
        SYS_CONNECT_BY_PATH(username, '/') as path
        FROM users
        START WITH manager_id IS NULL
        CONNECT BY PRIOR user_id = manager_id
        ORDER SIBLINGS BY username
    </select>

    <!-- Query with sequence -->
    <insert id="insertUser" parameterType="User">
        INSERT INTO users (
        user_id, username, email, created_date, status
        ) VALUES (
        user_seq.NEXTVAL,
        #{username},
        #{email},
        SYSDATE,
        'ACTIVE'
        )
    </insert>

    <!-- Query with LISTAGG -->
    <select id="getDepartmentUsers" resultType="DepartmentSummary">
        SELECT
        department_id,
        department_name,
        LISTAGG(username, ', ') WITHIN GROUP (ORDER BY username) as user_list,
        COUNT(*) as user_count
        FROM users u
        JOIN departments d ON u.department_id = d.department_id
        GROUP BY department_id, department_name
    </select>

    <!-- Query with Oracle hint -->
    <select id="getUsersWithIndex" resultType="User">
        SELECT /*+ INDEX(users idx_user_email) */
        user_id, username, email
        FROM users
        WHERE email = #{email}
    </select>

    <!-- Query with DUAL -->
    <select id="getCurrentDate" resultType="java.sql.Timestamp">
        SELECT SYSDATE FROM DUAL
    </select>

